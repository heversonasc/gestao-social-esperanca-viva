# Copie este arquivo para .env e ajuste os valores.
SECRET_KEY=gere-uma-chave-secreta-para-seu-ambiente
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Para desenvolvimento local, mantenha DB_ENGINE=sqlite3.
# Para PostgreSQL, use DB_ENGINE=postgresql e preencha os campos abaixo.
DB_ENGINE=sqlite3
DB_NAME=gestao_social
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
